{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bestaitoolsfree",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "bestaitoolsfree.com",
      "custom_domain": true
    },
    {
      "pattern": "www.bestaitoolsfree.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "DB_NAME": "ai_directory",
    "NEXTAUTH_URL": "https://www.bestaitoolsfree.com",
    "CORS_ORIGINS": "*"
  }
}
